# Copy this file to .env and fill in real values.

# Server
PORT=6767

# Storage backend: 'mysql' (default, needs the DB_* settings below and
# schema.sql loaded) or 'json' (dev mode — no database needed at all;
# game data is kept in a local JSON file under data/).
STORAGE=mysql

# MySQL connection (see schema.sql) — only used when STORAGE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skipbo

# Where the JSON dev store is written — only used when STORAGE=json
# JSON_DB_PATH=./data/dev-db.json

# express-session
SESSION_SECRET=change-this-to-a-long-random-string
