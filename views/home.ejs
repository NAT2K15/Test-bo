<%- include('partials/head', { title: 'Skip-Bo' }) %>

<main class="max-w-md mx-auto mt-12 px-4">
  <div class="text-center mb-10">
    <div class="brand-logo mx-auto">SKIP<br>BO</div>
    <p class="text-slate-500 text-sm mt-3 tracking-wide">Play the classic card game with friends</p>
  </div>

  <% if (error) { %>
    <div class="bg-red-800/60 border border-red-600 text-red-100 rounded-md px-4 py-2 mb-6 text-sm">
      <%= error %>
    </div>
  <% } %>

  <% if (!displayName) { %>
    <form action="/name" method="POST" class="bg-slate-800 rounded-2xl p-6 shadow-lg space-y-4 border border-slate-700">
      <label class="block text-sm font-medium text-slate-300">What should we call you?</label>
      <input name="displayName" maxlength="30" required autofocus
        class="w-full rounded-full bg-slate-700 border border-slate-600 px-5 py-3 text-center text-lg text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500"
        placeholder="Your name" />
      <button type="submit"
        class="w-full bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold rounded-full py-3 transition shadow-md">
        Let's Play
      </button>
    </form>
  <% } else { %>
    <div class="flex items-center justify-center gap-3 mb-6">
      <div class="name-plate">
        <span class="name-plate-avatar"><%= displayName.charAt(0).toUpperCase() %></span>
        <span class="font-semibold"><%= displayName %></span>
      </div>
      <a href="#" onclick="document.getElementById('rename').classList.toggle('hidden'); return false;"
        class="text-xs text-slate-500 underline">change</a>
    </div>

    <form id="rename" action="/name" method="POST" class="hidden bg-slate-800 rounded-2xl p-4 mb-6 space-y-3 border border-slate-700">
      <input name="displayName" maxlength="30" required value="<%= displayName %>"
        class="w-full rounded-full bg-slate-700 border border-slate-600 px-4 py-2 text-center text-slate-100" />
      <button type="submit" class="w-full bg-slate-600 hover:bg-slate-500 rounded-full py-2">Save</button>
    </form>

    <div class="grid grid-cols-1 gap-6">
      <form action="/game/create" method="POST" class="bg-slate-800 rounded-2xl p-6 shadow-lg space-y-4 border border-slate-700">
        <h2 class="text-xl font-bold text-emerald-400">Create a Room</h2>
        <label class="block text-sm font-medium text-slate-300">Max players</label>
        <select name="maxPlayers" class="w-full rounded-full bg-slate-700 border border-slate-600 px-4 py-2 text-center">
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4" selected>4</option>
          <option value="5">5</option>
          <option value="6">6</option>
        </select>
        <button type="submit"
          class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-bold rounded-full py-3 transition shadow-md">
          Create Room
        </button>
      </form>

      <form action="/game/join" method="POST" class="bg-slate-800 rounded-2xl p-6 shadow-lg space-y-4 border border-slate-700">
        <h2 class="text-xl font-bold text-sky-400">Join a Room</h2>
        <label class="block text-sm font-medium text-slate-300">Room code</label>
        <input name="roomCode" maxlength="5" required
          class="w-full uppercase tracking-[0.3em] text-center text-lg font-bold rounded-full bg-slate-700 border border-slate-600 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-sky-500"
          placeholder="ABCDE" />
        <button type="submit"
          class="w-full bg-sky-500 hover:bg-sky-400 text-slate-900 font-bold rounded-full py-3 transition shadow-md">
          Join Room
        </button>
      </form>
    </div>
  <% } %>
</main>

<%- include('partials/foot') %>
