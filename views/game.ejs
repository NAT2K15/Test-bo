<%- include('partials/head', { title: 'Skip-Bo — ' + roomCode }) %>

<main class="max-w-6xl mx-auto px-4 py-6" data-room-code="<%= roomCode %>" data-is-host="<%= isHost %>">
  <div id="toast" class="hidden bg-red-800/70 border border-red-600 text-red-100 rounded-md px-4 py-2 mb-4 text-sm"></div>

  <header class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="brand-logo" style="font-size: 1.3rem; padding: 0.4rem 0.8rem;">SKIP<br>BO</div>
    <p class="text-slate-500 text-sm">Room <span class="font-mono"><%= roomCode %></span></p>
    <div id="turn-indicator" class="text-lg font-semibold px-4 py-2 rounded-md bg-slate-800"></div>
  </header>

  <section id="opponents" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6"></section>

  <section class="bg-slate-800/60 rounded-lg p-4 mb-6">
    <h2 class="text-sm uppercase tracking-wide text-slate-400 mb-3">Building Piles</h2>
    <div class="flex flex-wrap gap-6 items-end justify-center">
      <div id="building-piles" class="flex flex-wrap gap-4"></div>
      <div class="pile-wrap">
        <span class="pile-label">Draw Pile</span>
        <div id="draw-pile-visual" class="draw-pile-stack"></div>
      </div>
    </div>
  </section>

  <section id="my-area-panel" class="relative bg-slate-800/60 rounded-lg p-4 mb-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm uppercase tracking-wide text-slate-400">Your Area</h2>
      <div class="relative">
        <button id="my-reaction-btn" class="reaction-btn" title="React">🙂</button>
        <div id="my-reaction-picker" class="reaction-picker hidden" style="right: 0; top: 2.5rem;"></div>
      </div>
    </div>
    <div class="flex flex-wrap gap-6 items-start">
      <div>
        <p class="text-xs text-slate-500 mb-1">Stockpile</p>
        <div id="my-stockpile"></div>
      </div>
      <div>
        <p class="text-xs text-slate-500 mb-1">Discard Piles</p>
        <div id="my-discard-piles" class="flex gap-4"></div>
      </div>
    </div>
    <p class="text-xs text-slate-500 mt-4 mb-1">Your Hand &mdash; drag a card onto a pile, or tap to select</p>
    <div id="my-hand" class="flex flex-wrap gap-3"></div>
  </section>
</main>

<div id="game-over" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50">
  <div class="bg-slate-800 rounded-lg p-8 text-center max-w-sm mx-4 shadow-2xl">
    <h2 class="text-3xl font-bold text-amber-400 mb-2">Game Over</h2>
    <p id="winner-text" class="text-slate-200 mb-6"></p>
    <button id="play-again-btn" class="w-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-semibold rounded-md py-3">
      Play Again
    </button>
    <p id="play-again-wait" class="hidden text-slate-500 text-sm mt-3">Waiting for the host to restart&hellip;</p>
  </div>
</div>

<%- include('partials/foot') %>
<script src="/js/game.js"></script>
