<%- include('partials/head', { title: 'Lobby ' + roomCode }) %>

<main class="max-w-xl mx-auto mt-12 px-4" data-room-code="<%= roomCode %>" data-is-host="<%= isHost %>">
  <div class="text-center mb-8">
    <p class="text-slate-400 text-sm uppercase tracking-wide">Room Code</p>
    <p class="text-5xl font-mono font-bold text-amber-400 tracking-[0.3em]"><%= roomCode %></p>
    <p class="text-slate-500 text-sm mt-2">Share this code so friends can join</p>
  </div>

  <div id="toast" class="hidden bg-red-800/70 border border-red-600 text-red-100 rounded-md px-4 py-2 mb-4 text-sm"></div>

  <div class="bg-slate-800 rounded-lg p-6 shadow-lg mb-6">
    <h2 class="text-lg font-semibold mb-4 text-slate-200">Players (<span id="player-count">0</span>/<%= maxPlayers %>)</h2>
    <ul id="player-list" class="space-y-2"></ul>
  </div>

  <% if (isHost) { %>
    <div class="bg-slate-800 rounded-lg p-6 shadow-lg mb-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-300 mb-1">Turn timer (optional)</label>
        <select id="turn-timer" class="w-full rounded-md bg-slate-700 border border-slate-600 px-3 py-2">
          <option value="">No timer</option>
          <option value="15">15 seconds</option>
          <option value="30">30 seconds</option>
          <option value="60">60 seconds</option>
        </select>
      </div>
      <button id="start-btn" disabled
        class="w-full bg-emerald-500 disabled:bg-slate-600 disabled:cursor-not-allowed hover:bg-emerald-400 text-slate-900 font-semibold rounded-md py-3 transition">
        Start Game
      </button>
      <p class="text-xs text-slate-500 text-center">Need at least 2 players to start.</p>
    </div>
  <% } else { %>
    <p class="text-center text-slate-400">Waiting for the host to start the game&hellip;</p>
  <% } %>

  <a href="/" class="block text-center text-sm text-slate-500 underline mt-6">Leave</a>
</main>

<%- include('partials/foot') %>
<script src="/js/lobby.js"></script>
